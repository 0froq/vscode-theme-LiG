{
  "name": "theme-lig",
  "displayName": "LiG Theme for Code",
  "publisher": "froQ",
  "version": "0.2.0",
  "description": "LiG: a quiet theme with four variants from one palette",
  "license": "MIT",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Themes"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/0froq/vscode-theme-LiG"
  },
  "contributes": {
    "themes": [
      {
        "label": "LiG Light",
        "uiTheme": "vs",
        "path": "./themes/lig-light.json"
      },
      {
        "label": "LiG Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/lig-dark.json"
      },
      {
        "label": "LiG Light Paper",
        "uiTheme": "vs",
        "path": "./themes/lig-light-paper.json"
      },
      {
        "label": "LiG Dark Paper",
        "uiTheme": "vs-dark",
        "path": "./themes/lig-dark-paper.json"
      }
    ]
  }
}
