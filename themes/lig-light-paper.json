  "tokenColors": [
    {
      "name": "LiG keyword",
      "scope": [
        "keyword",
        "storage.type"
      ],
      "settings": {
        "foreground": "#5f5d59"
      }
    },
    {
      "name": "LiG keyword.modifier",
      "scope": [
        "storage.modifier",
        "meta.directive",
        "entity.other.attribute-name.directive"
      ],
      "settings": {
        "foreground": "#38964d"
      }
    },
    {
      "name": "LiG keyword.action",
      "scope": [
        "keyword.control.return",
        "keyword.control.throw",
        "keyword.control.trycatch",
        "keyword.control.flow",
        "storage.modifier.async",
        "storage.type.function.async"
      ],
      "settings": {
        "foreground": "#cc7200"
      }
    },
    {
      "name": "LiG variable",
      "scope": [
        "variable.other.readwrite",
        "variable.other.object",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#2f2e2a"
      }
    },
    {
      "name": "LiG variable.builtin",
      "scope": [
        "variable.language",
        "variable.parameter.function.language.special"
      ],
      "settings": {
        "foreground": "#5560c1"
      }
    },
    {
      "name": "LiG parameter.binding",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#38964d"
      }
    },
    {
      "name": "LiG property",
      "scope": [
        "variable.other.property",
        "support.variable.property",
        "meta.object-literal.key",
        "meta.property-name",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#5f5d59"
      }
    },
    {
      "name": "LiG module",
      "scope": [
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#38964d"
      }
    },
    {
      "name": "LiG tag",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#38964d"
      }
    },
    {
      "name": "LiG type.reference",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#7b8bf0"
      }
    },
    {
      "name": "LiG type.definition",
      "scope": [
        "meta.class entity.name.type",
        "meta.interface entity.name.type",
        "meta.type.declaration entity.name.type",
        "entity.name.type.alias",
        "entity.name.type.interface"
      ],
      "settings": {
        "foreground": "#5560c1"
      }
    },
    {
      "name": "LiG function.definition",
      "scope": [
        "entity.name.function"
      ],
      "settings": {
        "foreground": "#cc7200"
      }
    },
    {
      "name": "LiG function.call",
      "scope": [
        "support.function",
        "meta.function-call entity.name.function",
        "meta.function-call.generic entity.name.function"
      ],
      "settings": {
        "foreground": "#cc7200"
      }
    },
    {
      "name": "LiG function.definition",
      "scope": [
        "support.function.builtin",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#cc7200"
      }
    },
    {
      "name": "LiG number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#6875d8"
      }
    },
    {
      "name": "LiG constant",
      "scope": [
        "constant.language",
        "entity.name.constant",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#6875d8"
      }
    },
    {
      "name": "LiG string",
      "scope": [
        "string",
        "constant.character"
      ],
      "settings": {
        "foreground": "#a6a49f"
      }
    },
    {
      "name": "LiG escape",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#5560c1"
      }
    },
    {
      "name": "LiG operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#6a6964"
      }
    },
    {
      "name": "LiG punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "delimiter"
      ],
      "settings": {
        "foreground": "#a6a49f"
      }
    },
    {
      "name": "LiG comment",
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#a6a49f"
      }
    },
    {
      "name": "LiG markup.heading",
      "scope": [
        "markup.heading",
        "markup.heading entity.name"
      ],
      "settings": {
        "foreground": "#2f2e2a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "LiG markup.strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#2f2e2a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "LiG markup.italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "LiG markup.quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#5f5d59",
        "fontStyle": "italic"
      }
    },
    {
      "name": "LiG markup.link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#6875d8",
        "fontStyle": "underline"
      }
    },
    {
      "name": "LiG markup.raw",
      "scope": [
        "markup.raw"
      ],
      "settings": {
        "foreground": "#5f5d59"
      }
    }
  ]
}
