    "terminal.ansiBrightGreen": "#1d8139",
    "terminal.ansiYellow": "#dbb800",
    "terminal.ansiBrightYellow": "#c2a200",
    "terminal.ansiBlue": "#6875d8",
    "terminal.ansiBrightBlue": "#5560c1",
    "terminal.ansiMagenta": "#ac5db1",
    "terminal.ansiBrightMagenta": "#95489b",
    "terminal.ansiCyan": "#009392",
