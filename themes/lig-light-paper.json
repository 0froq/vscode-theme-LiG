{
  "$schema": "vscode://schemas/color-theme",
  "name": "LiG Light Paper",
  "type": "light",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": {
      "foreground": "#38964d"
    },
    "class": {
      "foreground": "#7b8bf0"
    },
    "enum": {
      "foreground": "#6875d8"
    },
    "interface": {
      "foreground": "#7b8bf0"
    },
    "struct": {
      "foreground": "#7b8bf0"
    },
    "typeParameter": {
      "foreground": "#7b8bf0"
    },
    "type": {
      "foreground": "#7b8bf0"
    },
    "parameter": {
      "foreground": "#2f2e2a"
    },
    "variable": {
      "foreground": "#2f2e2a"
    },
    "property": {
      "foreground": "#5f5d59"
    },
    "enumMember": {
      "foreground": "#6875d8"
    },
    "decorator": {
      "foreground": "#38964d"
    },
    "event": {
      "foreground": "#cc7200"
    },
    "function": {
      "foreground": "#cc7200"
    },
    "method": {
      "foreground": "#cc7200"
    },
    "macro": {
      "foreground": "#cc7200"
    },
    "label": {
      "foreground": "#6875d8"
    },
    "comment": {
      "foreground": "#a6a49f"
    },
    "string": {
      "foreground": "#a6a49f"
    },
    "keyword": {
      "foreground": "#5f5d59"
    },
    "number": {
      "foreground": "#6875d8"
    },
    "regexp": {
      "foreground": "#5560c1"
    },
    "operator": {
      "foreground": "#6a6964"
    },
    "boolean": {
      "foreground": "#6875d8"
    },
    "namespace.declaration": {
      "foreground": "#1d8139"
    },
    "namespace.definition": {
      "foreground": "#1d8139"
    },
    "class.declaration": {
      "foreground": "#5560c1"
    },
    "class.definition": {
      "foreground": "#5560c1"
    },
    "enum.declaration": {
      "foreground": "#5560c1"
    },
    "enum.definition": {
      "foreground": "#5560c1"
    },
    "interface.declaration": {
      "foreground": "#5560c1"
    },
    "interface.definition": {
      "foreground": "#5560c1"
    },
    "struct.declaration": {
      "foreground": "#5560c1"
    },
    "struct.definition": {
      "foreground": "#5560c1"
    },
    "typeParameter.declaration": {
      "foreground": "#5560c1"
    },
    "typeParameter.definition": {
      "foreground": "#5560c1"
    },
    "type.declaration": {
      "foreground": "#5560c1"
    },
    "type.definition": {
      "foreground": "#5560c1"
    },
    "parameter.declaration": {
      "foreground": "#38964d"
    },
    "parameter.definition": {
      "foreground": "#38964d"
    },
    "property.declaration": {
      "foreground": "#38964d"
    },
    "property.definition": {
      "foreground": "#38964d"
    },
    "enumMember.declaration": {
      "foreground": "#5560c1"
    },
    "enumMember.definition": {
      "foreground": "#5560c1"
    },
    "event.declaration": {
      "foreground": "#cc7200"
    },
    "event.definition": {
      "foreground": "#cc7200"
    },
    "function.declaration": {
      "foreground": "#cc7200"
    },
    "function.definition": {
      "foreground": "#cc7200"
    },
    "method.declaration": {
      "foreground": "#cc7200"
    },
    "method.definition": {
      "foreground": "#cc7200"
    },
    "*.defaultLibrary": {
      "italic": true
    },
    "*.deprecated": {
      "strikethrough": true
    },
    "magicFunction": {
      "foreground": "#cc7200"
    },
    "magicFunction.declaration": {
      "foreground": "#cc7200"
    },
    "selfParameter": {
      "foreground": "#5560c1"
    },
    "selfParameter.declaration": {
      "foreground": "#1d8139"
    },
    "clsParameter": {
      "foreground": "#5560c1"
    },
    "clsParameter.declaration": {
      "foreground": "#1d8139"
    },
    "class.builtin": {
      "foreground": "#5560c1"
    },
    "class.typeHint": {
      "foreground": "#7b8bf0"
    },
    "class.decorator": {
      "foreground": "#38964d"
    },
    "function.builtin": {
      "foreground": "#cc7200"
    },
    "function.decorator": {
      "foreground": "#38964d"
    },
    "property.decorator": {
      "foreground": "#2f2e2a"
    }
  },
